   "source": [
    "This program:\n",
    "1. Import environment variables using load_api_key function\n",
    "2. Fetches games IDs from steam database (each game has an unique ID; steam DB has ~162,000 games)\n",
    "3. Using data IDs fetch each game information from server\n",
    "4. Structurize server about about the game; get rid of irrelevant attributes\n",
    "5. saves them all in json files, with limit of 10 000 lines / file."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "8df76154",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json \n",
    "import requests\n",
    "import time\n",
    "import glob\n",
    "from dotenv import load_dotenv\n",
    "import os\n",
    "import re\n"
   ]
  },
